# Server Configuration
PORT=3001
CLIENT_URL=http://127.0.0.1:5173

# Secret used to sign the session cookie (required in production, >= 32 chars).
# Generate one with: openssl rand -hex 32
COOKIE_SECRET=

# Redis connection string (BullMQ queue + library cache)
REDIS_URL=redis://localhost:6379

# YouTube (Google) OAuth Configuration
# Create OAuth credentials in Google Cloud Console:
# - Enable "YouTube Data API v3"
# - Create OAuth Client ID (Web application)
# - Authorized redirect URI MUST match YOUTUBE_REDIRECT_URI
YOUTUBE_CLIENT_ID=your_google_oauth_client_id_here
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret_here
YOUTUBE_REDIRECT_URI=http://127.0.0.1:3001/api/auth/youtube/callback

# Environment
NODE_ENV=development